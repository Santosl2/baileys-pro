{
  "extends": "./tsconfig.json",
  "compilerOptions": {
   "noEmitOnError": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "checkJs": false,
    "strict": false,
    "allowImportingTsExtensions": false,
    "outDir": "lib",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": ["node_modules","src/__tests__"]
}
