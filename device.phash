import { createHash } from 'crypto'

function sha256(buffer: Buffer): Buffer {
  return createHash('sha256').update(buffer).digest()
}

// Replica toString({ legacy: true, formatFull: true }) do WAWebWid.js
function widToLegacyFormatFull(jid: string): string {
  const atIdx = jid.lastIndexOf('@')
  const server = jid.slice(atIdx + 1)
  const local = jid.slice(0, atIdx)

  const colonIdx = local.indexOf(':')
  let user: string
  let device: number

  if (colonIdx !== -1) {
    user = local.slice(0, colonIdx)
    device = parseInt(local.slice(colonIdx + 1), 10) || 0
  } else {
    user = local
    device = 0
  }

  // legacy: só c.us vira s.whatsapp.net; lid, g.us etc ficam iguais
  const legacyServer = server === 'c.us' ? 's.whatsapp.net' : server

  // formatFull: sempre "{user}.0:{device}@{server}"
  return `${user}.0:${device}@${legacyServer}`
}

export function generateParticipantHashV2(jids: string[]): string {
  jids.sort()
	const sha256Hash = sha256(Buffer.from(jids.join('')))
	return '2:' + sha256Hash.slice(0, 6).toString('base64')
}

